Options -Indexes

AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On

# Block non-public internals and retired artifacts from direct web access.
RewriteRule ^(?:includes|src|sql|_legacy|backups|logs|visual-qa)(?:/|$) - [R=404,L]

# Force HTTPS in production hosting
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Esta pasta e a copia "mestre" (sem db_runtime_config.php proprio) usada como
# template do provisionamento e como dominio do painel admin. Toda instancia
# real de cliente tem seu proprio db_runtime_config.php (gerado no provisionamento)
# e por isso NAO cai nesta regra (o -f abaixo e relativo a cada pasta).
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
RewriteCond includes/db_runtime_config.php !-f
RewriteCond db_runtime_config.php !-f
RewriteRule ^(index\.html|login\.html)?$ admin/login.php [L,R=302]

# Public entry points after repository reorganization.
RewriteRule ^$ pages/index.html [L,R=302]
RewriteRule ^([^/]+\.html)$ pages/$1 [L,R=302]
RewriteRule ^(service-worker\.js|manifest\.json|manifest\.webmanifest|app\.webmanifest|favicon\.ico)$ public/$1 [L]
RewriteRule ^([^/]+\.(?:css|js|png|jpe?g|gif|webp|ico|ttf|woff2?))$ assets/$1 [L]
RewriteRule ^([^/]+\.php)$ api/$1 [L,R=307]
</IfModule>


<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# HSTS only on HTTPS responses
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

# Basic CSP allowing needed resources
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Block sensitive setup/reset/sql files in production
<FilesMatch "^(setup\.html|install\.php|reset\.php|comanda_online\.sql|comanda_online_atualizado\.sql)$">
	<IfModule mod_authz_core.c>
		Require local
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
		Allow from 127.0.0.1
		Allow from ::1
	</IfModule>
</FilesMatch>

RedirectMatch 404 ^/(?:includes|src|sql|_legacy|backups|logs|visual-qa)(?:/|$)

# Hide legacy duplicate folders if they still exist
RewriteRule ^js/ - [R=404,L]
